<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>MianMianPet</AssemblyName>
    <RootNamespace>MianMianPet</RootNamespace>
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Images\MianMianPet.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <InternalsVisibleTo Include="MianMianPet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\persona-prompt.txt" LogicalName="MianMianPet.Resources.persona-prompt.txt" />
    <Resource Include="Resources\Images\sheep-mascot.png" />
    <Resource Include="Resources\Images\sheep-icon.png" />
    <Resource Include="Resources\Images\MianMianPet.ico" />
  </ItemGroup>
</Project>
