<UserControl x:Class="MianMianPet.Views.ChatBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{Binding BubbleWidth}">
    <Grid Margin="8,8,8,18">
        <Grid x:Name="CloudRoot"
              RenderTransformOrigin="0.5,0.8">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- Cloud background lives on its own layer so the text never receives the shadow. -->
            <Grid x:Name="CloudSilhouette" IsHitTestVisible="False">
                <Grid.Effect>
                    <DropShadowEffect Color="#604B433D"
                                      BlurRadius="17"
                                      ShadowDepth="4"
                                      Opacity="0.2" />
                </Grid.Effect>

                <Viewbox Height="61" VerticalAlignment="Top" Stretch="Fill">
                <Canvas Width="354" Height="61">
                    <Ellipse Canvas.Left="9" Canvas.Top="23" Width="72" Height="43"
                             Fill="#FFFFFCFA" Stroke="#E8D2D7" StrokeThickness="1" />
                    <Ellipse Canvas.Left="56" Canvas.Top="9" Width="88" Height="59"
                             Fill="#FFFFFCFA" Stroke="#E8D2D7" StrokeThickness="1" />
                    <Ellipse Canvas.Left="123" Canvas.Top="0" Width="104" Height="72"
                             Fill="#FFFFFCFA" Stroke="#E8D2D7" StrokeThickness="1" />
                    <Ellipse Canvas.Left="205" Canvas.Top="10" Width="89" Height="58"
                             Fill="#FFFFFCFA" Stroke="#E8D2D7" StrokeThickness="1" />
                    <Ellipse Canvas.Left="278" Canvas.Top="24" Width="68" Height="42"
                             Fill="#FFFFFCFA" Stroke="#E8D2D7" StrokeThickness="1" />
                </Canvas>
                </Viewbox>

                <Border Margin="0,34,0,15"
                        Background="#FFFFFCFA"
                        BorderBrush="#E8D2D7"
                        BorderThickness="1,0,1,1"
                        CornerRadius="31" />

                <Ellipse Width="17" Height="12"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="16,0,0,5"
                         Fill="#FFFFFCFA"
                         Stroke="#E8D2D7"
                         StrokeThickness="1" />
                <Ellipse Width="9" Height="9"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="40,0,0,-4"
                         Fill="#FFFFFCFA"
                         Stroke="#E8D2D7"
                         StrokeThickness="1" />
            </Grid>

            <Border x:Name="BubbleBorder"
                    Margin="0,34,0,15"
                    Padding="22,18,22,17"
                    Background="Transparent">
                <Grid>
                    <StackPanel x:Name="ThinkingDots"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="10,7"
                                Visibility="{Binding IsThinking, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#E7AEB7" Margin="4" />
                        <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#D9C2D8" Margin="4" />
                        <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#E7AEB7" Margin="4" />
                    </StackPanel>
                    <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsThinking, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock x:Name="MessageText"
                               Text="{Binding BubbleText}"
                               FontSize="14.5"
                               LineHeight="23"
                               TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CloudRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetName="CloudRoot"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.94" To="1" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CloudRoot"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.94" To="1" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="1" Duration="0:0:0.5"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="1" BeginTime="0:0:0.16" Duration="0:0:0.5"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="1" BeginTime="0:0:0.32" Duration="0:0:0.5"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
