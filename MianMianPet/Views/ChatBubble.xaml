<UserControl x:Class="MianMianPet.Views.ChatBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="368" UseLayoutRounding="True">
    <UserControl.Resources>
        <Storyboard x:Key="ThinkingPulse">
            <DoubleAnimation Storyboard.TargetName="DotOne" Storyboard.TargetProperty="Opacity"
                             From="0.28" To="1" Duration="0:0:0.46" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="DotTwo" Storyboard.TargetProperty="Opacity"
                             From="0.28" To="1" BeginTime="0:0:0.14" Duration="0:0:0.46"
                             AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="DotThree" Storyboard.TargetProperty="Opacity"
                             From="0.28" To="1" BeginTime="0:0:0.28" Duration="0:0:0.46"
                             AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>
    <Grid Margin="12" Style="{StaticResource FloatingSurfaceMotion}">
        <Border Style="{StaticResource FloatingCard}" />
        <Grid Margin="16,12,16,14" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource CloudTintBrush}">
                    <Path Style="{StaticResource CloudMark}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding PetName}" Margin="8,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CloudInkBrush}" />
                <TextBlock Grid.Column="2" Text="正在想…" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource CloudMutedBrush}"
                           Visibility="{Binding IsThinking, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <Grid Grid.Row="1" MinHeight="24">
                <StackPanel x:Name="ThinkingDots" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsThinking, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse x:Name="DotOne" Width="6" Height="6" Margin="1,0,5,0" Fill="#B67695" />
                    <Ellipse x:Name="DotTwo" Width="6" Height="6" Margin="1,0,5,0" Fill="#B67695" />
                    <Ellipse x:Name="DotThree" Width="6" Height="6" Margin="1,0,5,0" Fill="#B67695" />
                </StackPanel>
                <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" MaxHeight="250"
                              Visibility="{Binding IsThinking, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="8" />
                            <Setter Property="Margin" Value="7,0,0,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Border Background="{StaticResource CloudTintBrush}" CornerRadius="4">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="#B888A3" CornerRadius="4" />
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <TextBlock Text="{Binding BubbleText}" FontSize="14" LineHeight="23" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
