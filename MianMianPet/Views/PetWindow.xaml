<Window x:Class="MianMianPet.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MianMianPet.Views"
        Title="{Binding PetName, StringFormat={}{0} AI 桌宠}"
        Icon="/MianMianPet;component/Resources/Images/MianMianPet.ico"
        Width="150" Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_OnLoaded"
        LocationChanged="Window_OnLocationChanged"
        Activated="Window_OnActivationChanged"
        Deactivated="Window_OnActivationChanged"
        PreviewMouseDown="Window_OnPreviewMouseDown"
        IsVisibleChanged="Window_OnIsVisibleChanged"
        Closing="Window_OnClosing">
    <Grid x:Name="PetRoot">
        <Border x:Name="PetHitArea"
                Background="#01000000"
                CornerRadius="70"
                Margin="9"
                Cursor="Hand"
                MouseLeftButtonDown="Pet_OnMouseLeftButtonDown"
                MouseMove="Pet_OnMouseMove"
                MouseLeftButtonUp="Pet_OnMouseLeftButtonUp"
                LostMouseCapture="Pet_OnLostMouseCapture"
                MouseEnter="Pet_OnMouseEnter"
                MouseLeave="Pet_OnMouseLeave">
            <Border.ContextMenu>
                <ContextMenu Background="#FFF9F7" BorderBrush="#EFD8DB" Padding="4">
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Padding" Value="13,8" />
                            <Setter Property="Foreground" Value="#4B433D" />
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="设置" Click="SettingsMenuItem_OnClick" />
                    <MenuItem Header="退出" Click="ExitMenuItem_OnClick" />
                </ContextMenu>
            </Border.ContextMenu>
            <Viewbox Stretch="Uniform">
                <local:PetVisual x:Name="PetArtwork" />
            </Viewbox>
        </Border>

        <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,4,0,0" Padding="10,5"
                CornerRadius="12" Background="#EFFFF9F0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="{Binding IsHoverHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="摸摸头，聊聊天" FontSize="12" />
        </Border>

        <Button Width="44" Height="34" Margin="0,24,5,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Command="{Binding OpenGiftCommand}" Cursor="Hand"
                ToolTip="绵绵藏了一封信，点开看看"
                Visibility="{Binding HasGift, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="GiftCloud" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                        <Path Data="M7,29 C-2,29 -1,16 6,14 C3,4 17,0 22,8 C29,0 40,7 38,15 C48,19 44,29 37,29Z"
                              Fill="#FFFFFCFA" Stroke="#E4B7C3" StrokeThickness="1.3" />
                        <Path Data="M15,16 C15,12 20,12 22,16 C24,12 29,12 29,16 C29,20 22,24 22,24 C22,24 15,20 15,16Z"
                              Fill="#ECA0B5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GiftCloud" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.08" ScaleY="1.08" /></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Popup x:Name="BubblePopup"
               PlacementTarget="{Binding ElementName=PetRoot}"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               IsOpen="{Binding IsBubbleOpen, Mode=OneWay}"
               Opened="BubblePopup_OnOpened">
            <local:ChatBubble x:Name="BubbleControl"
                              MouseEnter="Bubble_OnMouseEnter"
                              MouseLeave="Bubble_OnMouseLeave"
                              SizeChanged="Bubble_OnSizeChanged" />
        </Popup>

        <Popup x:Name="PlayPopup" PlacementTarget="{Binding ElementName=PetRoot}"
               AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True"
               Opened="PlayPopup_OnOpened">
            <local:PetPlayPanel x:Name="PlayPanel" />
        </Popup>
    </Grid>
</Window>
