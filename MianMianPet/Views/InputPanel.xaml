<UserControl x:Class="MianMianPet.Views.InputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="12" Style="{StaticResource FloatingSurfaceMotion}">
        <Border Style="{StaticResource FloatingCard}" />
        <Grid Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource CloudTintBrush}">
                    <Path Style="{StaticResource CloudMark}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding PetName, StringFormat=和{0}说话}" Margin="8,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CloudInkBrush}" />
                <TextBlock Grid.Column="2" Text="Enter 发送" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource CloudMutedBrush}" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Padding="9,1" Background="White" CornerRadius="12" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource CloudBorderBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="#BD88A4" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBox x:Name="MessageInput"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="2000" MinHeight="34" MaxHeight="98" Padding="1,6"
                                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"
                                 InputMethod.IsInputMethodEnabled="True" InputMethod.IsInputMethodSuspended="False"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="14"
                                 AutomationProperties.Name="聊天消息"
                                 ToolTip="Enter 发送，Shift+Enter 换行，Esc 收起" />
                        <TextBlock x:Name="PlaceholderText" Text="{Binding InputPlaceholder}" Margin="1,7,0,0"
                                   VerticalAlignment="Top" Foreground="{StaticResource CloudMutedBrush}"
                                   TextTrimming="CharacterEllipsis" FontSize="13" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom"
                        MinWidth="62" Height="38" Padding="12,0" Content="发送"
                        Style="{StaticResource PinkButton}" Command="{Binding SendCommand}"
                        FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold"
                        Foreground="{StaticResource CloudInkBrush}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
