<UserControl x:Class="MianMianPet.Views.PetVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="180"
             IsHitTestVisible="False"
             RenderTransformOrigin="0.5,0.82">

    <UserControl.Resources>
        <Storyboard x:Key="BreathingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PetScale" Storyboard.TargetProperty="ScaleY"
                             To="1.018" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PetTranslate" Storyboard.TargetProperty="Y"
                             To="-1.5" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="ClickStoryboard" FillBehavior="Stop">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PetScale" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.08" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PetScale" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.91" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PetTranslate" Storyboard.TargetProperty="Y">
                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="5" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="WakeStoryboard" FillBehavior="Stop">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PetScale" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.10" Value="0.92" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1.05" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PetTranslate" Storyboard.TargetProperty="Y">
                <EasingDoubleKeyFrame KeyTime="0:0:0.10" Value="4" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-4" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="PettingStoryboard" FillBehavior="Stop">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TouchRotate" Storyboard.TargetProperty="Angle">
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-5"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.65" Value="-3" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TouchTranslate" Storyboard.TargetProperty="X">
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-3" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.65" Value="-1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EarRotate" Storyboard.TargetProperty="Angle">
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="-13" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="7" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="-8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.85" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="PettingHeart" Storyboard.TargetProperty="Opacity"
                             From="0.9" To="0" BeginTime="0:0:0.2" Duration="0:0:1" />
            <DoubleAnimation Storyboard.TargetName="HeartTranslate" Storyboard.TargetProperty="Y"
                             From="4" To="-13" Duration="0:0:1.2" />
        </Storyboard>
        <Storyboard x:Key="ThinkingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PetTranslate" Storyboard.TargetProperty="Y"
                             To="-5" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PetRotate" Storyboard.TargetProperty="Angle"
                             To="2.5" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="SpeakingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PetRotate" Storyboard.TargetProperty="Angle"
                             To="-2" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PetTranslate" Storyboard.TargetProperty="Y"
                             To="-2" Duration="0:0:0.22" />
        </Storyboard>
        <Storyboard x:Key="ErrorStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PetTranslate" Storyboard.TargetProperty="X">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="-5" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="5" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.21" Value="-3" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="SleepingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PetScale" Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1.008" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PetTranslate" Storyboard.TargetProperty="Y"
                             From="1.5" To="0" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SleepZOverlay" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.95" Duration="0:0:1.8" />
            <DoubleAnimation Storyboard.TargetName="SleepZTranslate" Storyboard.TargetProperty="Y"
                             From="3" To="-3" Duration="0:0:1.8" />
        </Storyboard>
        <Storyboard x:Key="TimeOfDayTwinkleStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="NightStarOne" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.9" Duration="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="NightStarTwo" Storyboard.TargetProperty="Opacity"
                             From="0.75" To="0.2" Duration="0:0:2.1" />
        </Storyboard>
        <Storyboard x:Key="AmbientLoopStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="AmbientGlow" Storyboard.TargetProperty="Opacity"
                             From="0.28" To="0.66" Duration="0:0:2.8" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="LeftCloudTranslate" Storyboard.TargetProperty="X"
                             From="-2" To="5" Duration="0:0:4.6" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="LeftCloudTranslate" Storyboard.TargetProperty="Y"
                             From="1" To="-2" Duration="0:0:3.8" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="RightCloudTranslate" Storyboard.TargetProperty="X"
                             From="4" To="-4" Duration="0:0:5.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="RightCloudTranslate" Storyboard.TargetProperty="Y"
                             From="0" To="-2.5" Duration="0:0:4.3" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GrassSway" Storyboard.TargetProperty="Angle"
                             From="-1.2" To="1.2" Duration="0:0:2.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleOne" Storyboard.TargetProperty="Opacity"
                             From="0.15" To="1" Duration="0:0:1.15" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleTwo" Storyboard.TargetProperty="Opacity"
                             From="0.1" To="0.9" BeginTime="0:0:0.55" Duration="0:0:1.35" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleThree" Storyboard.TargetProperty="Opacity"
                             From="0.28" To="1" BeginTime="0:0:1.1" Duration="0:0:1.6" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleFour" Storyboard.TargetProperty="Opacity"
                             From="0.2" To="0.88" BeginTime="0:0:0.8" Duration="0:0:1.45" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleFive" Storyboard.TargetProperty="Opacity"
                             From="0.16" To="0.76" BeginTime="0:0:1.35" Duration="0:0:1.7" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleOneScale" Storyboard.TargetProperty="ScaleX"
                             From="0.68" To="1.16" Duration="0:0:1.15" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleOneScale" Storyboard.TargetProperty="ScaleY"
                             From="0.68" To="1.16" Duration="0:0:1.15" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleOneRotate" Storyboard.TargetProperty="Angle"
                             From="-7" To="7" Duration="0:0:2.3" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleTwoScale" Storyboard.TargetProperty="ScaleX"
                             From="0.72" To="1.12" BeginTime="0:0:0.55" Duration="0:0:1.35" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleTwoScale" Storyboard.TargetProperty="ScaleY"
                             From="0.72" To="1.12" BeginTime="0:0:0.55" Duration="0:0:1.35" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleFourScale" Storyboard.TargetProperty="ScaleX"
                             From="0.76" To="1.08" BeginTime="0:0:0.8" Duration="0:0:1.45" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SparkleFourScale" Storyboard.TargetProperty="ScaleY"
                             From="0.76" To="1.08" BeginTime="0:0:0.8" Duration="0:0:1.45" AutoReverse="True" />
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="DrawingRoot" Margin="2">
        <!-- A subtle always-on local-time atmosphere. The richer scenery still waits for idle. -->
        <Viewbox x:Name="TimeOfDayAtmosphere" Stretch="Uniform" Opacity="0.32" IsHitTestVisible="False">
            <Canvas Width="170" Height="170">
                <Ellipse x:Name="DayPhaseGlow" Canvas.Left="10" Canvas.Top="13" Width="150" Height="148">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#45FFE8BC" Offset="0" />
                            <GradientStop Color="#00FFF7EC" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="13" /></Ellipse.Effect>
                </Ellipse>

                <Canvas x:Name="SunDecoration" Opacity="0">
                    <Ellipse Canvas.Left="17" Canvas.Top="21" Width="12" Height="12" Fill="#FFFFD96E" />
                    <Ellipse Canvas.Left="13" Canvas.Top="17" Width="20" Height="20" Fill="#36FFE08A">
                        <Ellipse.Effect><BlurEffect Radius="6" /></Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <Canvas x:Name="MoonDecoration" Opacity="0">
                    <Path Canvas.Left="139" Canvas.Top="18" Width="16" Height="16" Stretch="Fill"
                          Fill="#FFF9F0C8"
                          Data="M14,1 C7,2 4,7 6,12 C8,16 13,17 17,14 C13,14 10,12 9,9 C8,5 10,3 14,1 Z">
                        <Path.Effect><DropShadowEffect Color="#FFB6C8FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8" /></Path.Effect>
                    </Path>
                    <Path x:Name="NightStarOne" Canvas.Left="129" Canvas.Top="31" Width="7" Height="7"
                          Stretch="Fill" Fill="#FFFFE9A8"
                          Data="M3.5,0 C3.9,2.3 4.7,3.1 7,3.5 C4.7,3.9 3.9,4.7 3.5,7 C3.1,4.7 2.3,3.9 0,3.5 C2.3,3.1 3.1,2.3 3.5,0 Z" />
                    <Ellipse x:Name="NightStarTwo" Canvas.Left="157" Canvas.Top="40" Width="3.5" Height="3.5" Fill="#FFF4D8FF" />
                </Canvas>
            </Canvas>
        </Viewbox>

        <Viewbox x:Name="AmbientScene" Stretch="Uniform" Opacity="0" IsHitTestVisible="False">
            <Canvas Width="170" Height="170">
                <!-- warm halo from the reference image -->
                <Ellipse x:Name="AmbientGlow" Canvas.Left="17" Canvas.Top="20" Width="136" Height="136"
                         Opacity="0.28">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#72FFD98A" Offset="0" />
                            <GradientStop Color="#28FFF0BD" Offset="0.52" />
                            <GradientStop Color="#00FFF7E8" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="12" /></Ellipse.Effect>
                </Ellipse>

                <!-- small floating clouds around the sheep -->
                <Canvas Canvas.Left="4" Canvas.Top="105" Width="38" Height="24">
                    <Canvas.RenderTransform><TranslateTransform x:Name="LeftCloudTranslate" /></Canvas.RenderTransform>
                    <Ellipse Canvas.Left="3" Canvas.Top="8" Width="31" Height="13" Fill="#F7FFFFFF" Stroke="#E6D5D2" StrokeThickness="1" />
                    <Ellipse Canvas.Left="7" Canvas.Top="3" Width="15" Height="15" Fill="#FFFFFFFF" Stroke="#E6D5D2" StrokeThickness="1" />
                    <Ellipse Canvas.Left="18" Canvas.Top="5" Width="13" Height="13" Fill="#FFFFFFFF" Stroke="#E6D5D2" StrokeThickness="1" />
                </Canvas>
                <Canvas Canvas.Left="137" Canvas.Top="108" Width="31" Height="20">
                    <Canvas.RenderTransform><TranslateTransform x:Name="RightCloudTranslate" /></Canvas.RenderTransform>
                    <Ellipse Canvas.Left="2" Canvas.Top="7" Width="26" Height="11" Fill="#F7FFFFFF" Stroke="#E6D5D2" StrokeThickness="1" />
                    <Ellipse Canvas.Left="6" Canvas.Top="2" Width="13" Height="13" Fill="#FFFFFFFF" Stroke="#E6D5D2" StrokeThickness="1" />
                    <Ellipse Canvas.Left="16" Canvas.Top="4" Width="11" Height="11" Fill="#FFFFFFFF" Stroke="#E6D5D2" StrokeThickness="1" />
                </Canvas>

                <!-- grass patch grows in beneath the sheep -->
                <Canvas x:Name="GrassPatch" Canvas.Left="8" Canvas.Top="132" Width="154" Height="34"
                        RenderTransformOrigin="0.5,1">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="GrassScale" ScaleY="0.72" />
                            <RotateTransform x:Name="GrassSway" Angle="0" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="7" Canvas.Top="17" Width="140" Height="15" Fill="#5BBDEB73" />
                    <Ellipse Canvas.Left="19" Canvas.Top="20" Width="116" Height="9" Fill="#A3D96A" Opacity="0.8" />
                    <Path Fill="#7FC85D" Data="M15,23 L18,8 L22,22 L27,5 L29,23 L36,11 L37,24 Z" />
                    <Path Fill="#8ED56A" Data="M113,24 L117,7 L120,22 L126,4 L127,23 L134,10 L135,24 Z" />
                    <Path Fill="#6FBD56" Data="M41,25 L45,12 L48,24 L53,9 L55,25 Z" />
                    <Path Fill="#75C45A" Data="M92,25 L96,10 L99,24 L104,8 L106,25 Z" />
                    <Ellipse Canvas.Left="32" Canvas.Top="12" Width="5" Height="5" Fill="#F6A9B7" />
                    <Ellipse Canvas.Left="136" Canvas.Top="13" Width="4" Height="4" Fill="#F6A9B7" />
                </Canvas>
            </Canvas>
        </Viewbox>

        <Grid x:Name="PetCharacter" RenderTransformOrigin="0.5,0.82">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="PetRotate" Angle="0" />
                    <TranslateTransform x:Name="PetTranslate" X="0" Y="0" />
                    <RotateTransform x:Name="TouchRotate" />
                    <TranslateTransform x:Name="TouchTranslate" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="PetImage"
                   Source="/MianMianPet;component/Resources/Images/sheep-mascot.png"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- The generated mascot is the artwork; this small expression layer preserves blink/talk/error feedback. -->
            <Viewbox Stretch="Uniform">
                <Canvas Width="170" Height="170">
                <!-- A small wool patch and articulated ear follow the original illustration. -->
                <Ellipse Canvas.Left="58" Canvas.Top="54" Width="29" Height="24" Fill="#FFFCF8" />
                <Path Data="M62,54 C64,56 67,59 73,62 C79,65 85,67 83,72 C81,79 68,78 64,73 C60,68 59,60 62,54Z"
                      Stroke="#BB8B78" StrokeThickness="1.5" StrokeLineJoin="Round">
                    <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFE8CE" Offset="0.55" /><GradientStop Color="#FFB29B" Offset="0.78" /><GradientStop Color="#F59588" Offset="1" /></LinearGradientBrush></Path.Fill>
                    <Path.RenderTransform><RotateTransform x:Name="EarRotate" CenterX="62" CenterY="54" /></Path.RenderTransform>
                </Path>
                <Canvas x:Name="OpenEyes">
                    <Ellipse Canvas.Left="34.5" Canvas.Top="60.5" Width="17" Height="15"
                             Fill="#FBE4C8" />
                    <Ellipse Canvas.Left="41" Canvas.Top="64" Width="5.2" Height="8.2"
                             Fill="#5C3025" />
                    <Ellipse Canvas.Left="42.2" Canvas.Top="65" Width="1.6" Height="2"
                             Fill="White" />
                </Canvas>
                <Canvas x:Name="ClosedEyes" Visibility="Collapsed">
                    <Ellipse Canvas.Left="34.5" Canvas.Top="60.5" Width="17" Height="15"
                             Fill="#FBE4C8" />
                    <Path Data="M38,67 Q43,72 49,67"
                          Stroke="#5C3025" StrokeThickness="2.3" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>

                <Path x:Name="IdleMouth" Data="M21,78 Q25,82 29,78"
                      Stroke="#8A4D3D" StrokeThickness="1.7" Fill="Transparent"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse x:Name="TalkMouth" Canvas.Left="21" Canvas.Top="77" Width="9" Height="7"
                         Fill="#8A4D3D" Visibility="Collapsed" />
                <Path x:Name="WorriedMouth" Data="M21,82 Q25,77 30,82"
                      Stroke="#8A4D3D" StrokeThickness="1.8" Fill="Transparent"
                      Visibility="Collapsed" StrokeStartLineCap="Round" />

                <Canvas x:Name="SleepZOverlay" Canvas.Left="16" Canvas.Top="38" Opacity="0" Visibility="Collapsed">
                    <Canvas.RenderTransform><TranslateTransform x:Name="SleepZTranslate" /></Canvas.RenderTransform>
                    <TextBlock Text="z" FontSize="13" FontWeight="SemiBold" Foreground="#FF9B91C8" />
                    <TextBlock Canvas.Left="9" Canvas.Top="-8" Text="z" FontSize="17" FontWeight="SemiBold" Foreground="#FFB0A5D9" />
                </Canvas>
                </Canvas>
            </Viewbox>
        </Grid>

        <!-- Sparkles are intentionally above the opaque sheep artwork so they stay visible. -->
        <Viewbox IsHitTestVisible="False">
            <Canvas Width="170" Height="170">
                <Path x:Name="PettingHeart" Canvas.Left="99" Canvas.Top="32" Opacity="0" Visibility="Collapsed"
                      Data="M0,5 C0,-1 7,-2 9,3 C12,-2 18,-1 18,5 C18,10 9,16 9,16 C9,16 0,10 0,5Z"
                      Fill="#F2A0B3" Stroke="#FFF5F7" StrokeThickness="1">
                    <Path.RenderTransform><TranslateTransform x:Name="HeartTranslate" /></Path.RenderTransform>
                </Path>
            </Canvas>
        </Viewbox>
        <Viewbox x:Name="AmbientSparkleOverlay" Stretch="Uniform" Opacity="0" IsHitTestVisible="False">
            <Canvas Width="170" Height="170">
                <Path x:Name="SparkleOne" Canvas.Left="15" Canvas.Top="24" Width="17" Height="17"
                      Stretch="Fill" Fill="#FFFFCB55" RenderTransformOrigin="0.5,0.5"
                      Data="M8.5,0 C9.4,5.7 11.3,7.6 17,8.5 C11.3,9.4 9.4,11.3 8.5,17 C7.6,11.3 5.7,9.4 0,8.5 C5.7,7.6 7.6,5.7 8.5,0 Z">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SparkleOneScale" ScaleX="0.9" ScaleY="0.9" />
                            <RotateTransform x:Name="SparkleOneRotate" />
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Effect><DropShadowEffect Color="#FFFFC23E" BlurRadius="11" ShadowDepth="0" Opacity="0.95" /></Path.Effect>
                </Path>

                <Path x:Name="SparkleTwo" Canvas.Left="5" Canvas.Top="43" Width="10" Height="10"
                      Stretch="Fill" Fill="#FFFFFFFF" Stroke="#DCCFE8" StrokeThickness="0.7"
                      RenderTransformOrigin="0.5,0.5"
                      Data="M5,0 C5.55,3.3 6.7,4.45 10,5 C6.7,5.55 5.55,6.7 5,10 C4.45,6.7 3.3,5.55 0,5 C3.3,4.45 4.45,3.3 5,0 Z">
                    <Path.RenderTransform><ScaleTransform x:Name="SparkleTwoScale" ScaleX="0.9" ScaleY="0.9" /></Path.RenderTransform>
                    <Path.Effect><DropShadowEffect Color="#FFF7EEFF" BlurRadius="7" ShadowDepth="0" Opacity="0.9" /></Path.Effect>
                </Path>

                <Ellipse x:Name="SparkleThree" Canvas.Left="31" Canvas.Top="45" Width="7" Height="7"
                         Fill="#FFFFC8AF">
                    <Ellipse.Effect><DropShadowEffect Color="#FFFFB68F" BlurRadius="7" ShadowDepth="0" Opacity="0.85" /></Ellipse.Effect>
                </Ellipse>

                <Path x:Name="SparkleFour" Canvas.Left="144" Canvas.Top="31" Width="9" Height="9"
                      Stretch="Fill" Fill="#FFFFE08B" RenderTransformOrigin="0.5,0.5"
                      Data="M4.5,0 C5,3 6,4 9,4.5 C6,5 5,6 4.5,9 C4,6 3,5 0,4.5 C3,4 4,3 4.5,0 Z">
                    <Path.RenderTransform><ScaleTransform x:Name="SparkleFourScale" ScaleX="0.9" ScaleY="0.9" /></Path.RenderTransform>
                    <Path.Effect><DropShadowEffect Color="#FFFFD65D" BlurRadius="8" ShadowDepth="0" Opacity="0.85" /></Path.Effect>
                </Path>

                <Ellipse x:Name="SparkleFive" Canvas.Left="151" Canvas.Top="56" Width="5" Height="5"
                         Fill="#FFF7AEBB">
                    <Ellipse.Effect><DropShadowEffect Color="#FFF7AEBB" BlurRadius="6" ShadowDepth="0" Opacity="0.8" /></Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Viewbox>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource BreathingStoryboard}" />
            <BeginStoryboard Storyboard="{StaticResource TimeOfDayTwinkleStoryboard}" />
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
