<UserControl x:Class="MianMianPet.Views.PetPlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MianMianPet.Views"
             Width="368" Height="275" Focusable="False"
             FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="CloudChoice" TargetType="Button">
            <Setter Property="Width" Value="102" />
            <Setter Property="Height" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="CloudBody" Background="Transparent">
                            <Ellipse Width="66" Height="8" Fill="#EBDFE7" Opacity="0.6"
                                     VerticalAlignment="Bottom" Margin="0,0,0,12" />
                            <Path x:Name="PeekEars" Visibility="Hidden"
                                  Data="M38,32 C20,26 22,3 29,6 C36,9 37,22 41,27 M60,31 C75,22 76,2 69,6 C62,10 61,21 57,26"
                                  Fill="#F2BECE" Stroke="#CA91A6" StrokeThickness="1.4" StrokeLineJoin="Round" />
                            <Path x:Name="CloudShape"
                                  Data="M20,68 C1,68 0,44 16,40 C13,22 35,16 46,29 C57,11 83,23 82,40 C102,41 102,68 82,68Z"
                                  Fill="#FFFFFE" Stroke="#E6D4DF" StrokeThickness="1.4" StrokeLineJoin="Round" />
                            <Border Width="22" Height="22" CornerRadius="11" Background="#FAF0F5"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,39,0,0">
                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#9B7186" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloudShape" Property="Fill" Value="#FFF3F8" />
                                <Setter TargetName="CloudShape" Property="Stroke" Value="#D6A0B6" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloudShape" Property="Stroke" Value="#BC7896" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloudShape" Property="Fill" Value="#F8E3ED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="CardShell" Margin="12" Padding="16" CornerRadius="26"
            Background="#FFFFFDFE" BorderBrush="#EEDFE7" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#785769" Opacity="0.13" BlurRadius="16" ShadowDepth="3" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="#654E62" />
                    <TextBlock x:Name="HintText" Margin="0,7,0,0" FontSize="11" Foreground="#987F90" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" x:Name="CountdownBadge" CornerRadius="12" Padding="9,5" Margin="8,0,0,0"
                        Background="#F8EAF1" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=CountdownText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="CountdownText" FontSize="11" FontWeight="SemiBold" Foreground="#AA6E8B" />
                </Border>
            </Grid>
            <Border Grid.Row="2" CornerRadius="20" BorderBrush="#F1E6ED" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFF5F8" Offset="0" />
                        <GradientStop Color="#F4F1FC" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Canvas x:Name="GameStage" Width="310" Height="144" ClipToBounds="True">
                        <Ellipse Width="4" Height="4" Fill="#E5CBDB" Canvas.Left="25" Canvas.Top="28" />
                        <Path Data="M0,5 L10,5 M5,0 L5,10" Stroke="#DECBE6" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Canvas.Left="267" Canvas.Top="20" />
                        <local:PetVisual x:Name="RevealPet" Width="100" Height="100" Visibility="Collapsed" IsHitTestVisible="False">
                            <local:PetVisual.RenderTransform><TranslateTransform /></local:PetVisual.RenderTransform>
                        </local:PetVisual>
                        <Button x:Name="CloudOne" Canvas.Left="0" Canvas.Top="43" Style="{StaticResource CloudChoice}"
                                Tag="0" Content="1" Click="Cloud_OnClick" AutomationProperties.Name="第一朵云" />
                        <Button x:Name="CloudTwo" Canvas.Left="104" Canvas.Top="43" Style="{StaticResource CloudChoice}"
                                Tag="1" Content="2" Click="Cloud_OnClick" AutomationProperties.Name="第二朵云" />
                        <Button x:Name="CloudThree" Canvas.Left="208" Canvas.Top="43" Style="{StaticResource CloudChoice}"
                                Tag="2" Content="3" Click="Cloud_OnClick" AutomationProperties.Name="第三朵云" />
                    </Canvas>
                    <Grid x:Name="WalkContent" Margin="17,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="74" Height="78" CornerRadius="24" Background="#FFFFFDFE"
                                BorderBrush="#F0E1EA" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="TreasureIcon" Width="44" Height="44" Stretch="Uniform"
                                  Stroke="#BE92A1" StrokeThickness="1.3" StrokeLineJoin="Round" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="云边的小惊喜" FontSize="10" Foreground="#AD8C9F" Margin="0,0,0,7" />
                            <TextBlock x:Name="TreasureName" FontSize="15" FontWeight="SemiBold" Foreground="#7D586F" />
                            <TextBlock x:Name="EncounterText" Margin="0,7,0,0" TextWrapping="Wrap"
                                       FontSize="11" LineHeight="19" Foreground="#927B8B" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
