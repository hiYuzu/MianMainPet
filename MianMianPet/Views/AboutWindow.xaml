<Window x:Class="MianMianPet.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于绵绵"
        Icon="/MianMianPet;component/Resources/Images/MianMianPet.ico"
        Width="430" Height="430"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="AboutCloseButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#8A7577" />
            <Setter Property="Background" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-2,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBackground" Property="Background" Value="#8CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBackground" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="#FFFFFCFA"
                BorderBrush="#EBD5DA"
                BorderThickness="1"
                CornerRadius="28">
            <Border.Effect>
                <DropShadowEffect Color="#5C6F555A"
                                  BlurRadius="24"
                                  ShadowDepth="6"
                                  Opacity="0.24" />
            </Border.Effect>

            <Grid ClipToBounds="True">
                <Ellipse Width="250" Height="190"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="-92,-92,0,0"
                         Fill="#8CFAE5E8" />
                <Ellipse Width="230" Height="180"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-88,-96"
                         Fill="#4DE9F1DF" />

                <Button Content="×"
                        Style="{StaticResource AboutCloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,14,14,0"
                        Click="Close_OnClick" />

                <StackPanel Margin="34,26,34,28"
                            HorizontalAlignment="Center">
                    <Grid Width="136" Height="132" HorizontalAlignment="Center">
                        <Ellipse Width="116" Height="105"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Bottom"
                                 Fill="#FFF2E8E9" />
                        <Ellipse Width="96" Height="89"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Fill="#FFFFF5EE" />
                        <Image Source="/MianMianPet;component/Resources/Images/sheep-icon.png"
                               Width="126" Height="126"
                               Stretch="Uniform" />
                    </Grid>

                    <TextBlock Text="绵绵 AI 桌宠"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#4B433D" />
                    <TextBlock Text="一只安静陪伴在桌面的云朵小羊"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13.5"
                               Foreground="#8A817A" />

                    <Border Margin="0,18,0,0"
                            Padding="17,8"
                            HorizontalAlignment="Center"
                            Background="#FFF1F3"
                            BorderBrush="#EACAD0"
                            BorderThickness="1"
                            CornerRadius="18">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="#D99EAA" />
                            <TextBlock x:Name="VersionText"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#755E62" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="安静陪伴 · 自然互动 · 偶尔带来小惊喜"
                               Margin="0,20,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12.5"
                               Foreground="#A09690" />

                    <Button Content="知道啦"
                            Style="{StaticResource PinkButton}"
                            Width="116"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Click="Close_OnClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
